# API — backend mount tại /v1. Trên thiết bị thật đổi localhost -> IP LAN của máy chạy server.
EXPO_PUBLIC_API_BASE_URL=https://smartstayai-system.onrender.com/v1

# App
EXPO_PUBLIC_APP_NAME=SmartStay AI

# Map (nếu dùng)
EXPO_PUBLIC_MAP_KEY=

# Staff portal — KS staff thao tác (tạm thời, đến khi backend có API assignment).
# Lấy 1 hotelId hợp lệ từ DB seed để test luồng vận hành staff trên thiết bị.
EXPO_PUBLIC_STAFF_HOTEL_ID=
