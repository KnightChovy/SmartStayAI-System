}

model PlatformRevenueStats {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @db.Date
  totalBookings   Int      @map("total_bookings")
  totalGmv        Decimal? @map("total_gmv") @db.Decimal(12, 2)
  totalCommission Decimal? @map("total_commission") @db.Decimal(12, 2)
  activeHotels    Int?     @map("active_hotels")
  activePartners  Int?     @map("active_partners")
  newPartners     Int?     @map("new_partners")
  calculatedAt    DateTime @map("calculated_at")

  @@map("platform_revenue_stats")
}

// ==========================================
// 3. ĐĂNG KÝ HOTEL PARTNER (Hồ sơ & duyệt)
// ==========================================

// Một yêu cầu duyệt hồ sơ đăng ký khách sạn của partner
model HotelVerificationRequest {
  id              String                    @id @default(uuid()) @db.Uuid
  partnerId       String                    @map("partner_id") @db.Uuid
  partner         HotelPartner              @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId         String                    @map("hotel_id") @db.Uuid
  hotel           Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status          VerificationRequestStatus
  submittedAt     DateTime                  @default(now()) @map("submitted_at")
  reviewedBy      String?                   @map("reviewed_by") @db.Uuid
  reviewer        User?                     @relation("verificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedAt      DateTime?                 @map("reviewed_at")
  rejectionReason String?                   @map("rejection_reason")
  notes           String?
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at")

  documents HotelVerificationDocument[]
  licenses  HotelLicense[]

  @@map("hotel_verification_requests")
}

// File giấy tờ nộp kèm để duyệt (mỗi file có trạng thái duyệt riêng)
model HotelVerificationDocument {
  id                    String                      @id @default(uuid()) @db.Uuid
  verificationRequestId String                      @map("verification_request_id") @db.Uuid
  verificationRequest   HotelVerificationRequest    @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  partnerId             String                      @map("partner_id") @db.Uuid
  partner               HotelPartner                @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId               String                      @map("hotel_id") @db.Uuid
  hotel                 Hotel                       @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentType          VerificationDocumentType    @map("document_type")
  fileUrl               String                      @map("file_url")
  status                VerificationDocumentStatus
  reviewedBy            String?                     @map("reviewed_by") @db.Uuid
  reviewer              User?                       @relation("documentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedAt            DateTime?                   @map("reviewed_at")
  // Tự tham chiếu: document này được thay thế bởi document nào (khi nộp lại)
  replacedById          String?                     @map("replaced_by") @db.Uuid
  replacedBy            HotelVerificationDocument?  @relation("documentReplacement", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces              HotelVerificationDocument[] @relation("documentReplacement")
  // Các license đang trỏ tới document này làm bản file hợp lệ hiện hành
  currentForLicenses    HotelLicense[]              @relation("currentDocument")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_verification_documents")
}

// Giấy phép có cấu trúc (số GP, ngày cấp/hết hạn, cơ quan cấp, hạng sao)
model HotelLicense {
  id                    String                     @id @default(uuid()) @db.Uuid
  hotelId               String                     @map("hotel_id") @db.Uuid
  hotel                 Hotel                      @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verificationRequestId String?                    @map("verification_request_id") @db.Uuid
  verificationRequest   HotelVerificationRequest?  @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  licenseType           LicenseType                @map("license_type")
  licenseNumber         String?                    @map("license_number")
  certificateNumber     String?                    @map("certificate_number")
  issueDate             DateTime?                  @map("issue_date") @db.Date
  expiryDate            DateTime?                  @map("expiry_date") @db.Date
  authority             String?
  validityStatus        LicenseValidityStatus?     @map("validity_status")
  starRating            LicenseStarRating?         @map("star_rating")
  // File không lưu ở đây nữa: trỏ tới bản document đã duyệt mới nhất trong hotel_verification_documents
  currentDocumentId     String?                    @map("current_document_id") @db.Uuid
  currentDocument       HotelVerificationDocument? @relation("currentDocument", fields: [currentDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @default(now()) @updatedAt @map("updated_at")

  @@index([hotelId, licenseType])
  @@map("hotel_licenses")
}

// Người đại diện pháp lý của khách sạn
model HotelRepresentative {
  id              String             @id @default(uuid()) @db.Uuid
  hotelId         String             @map("hotel_id") @db.Uuid
  hotel           Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  partnerId       String             @map("partner_id") @db.Uuid
  partner         HotelPartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fullName        String             @map("full_name")
  role            RepresentativeRole
  dateOfBirth     DateTime?          @map("date_of_birth") @db.Date
  idNumber        String             @map("id_number")
  phone           String?
  address         String?
  idFrontImageUrl String?            @map("id_front_image_url")
  idBackImageUrl  String?            @map("id_back_image_url")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_representatives")
}

// Tài khoản nhận tiền của khách sạn (số TK mã hoá ở tầng ứng dụng)
model HotelPayoutAccount {
  id                        String       @id @default(uuid()) @db.Uuid
  hotelId                   String       @map("hotel_id") @db.Uuid
  hotel                     Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  partnerId                 String       @map("partner_id") @db.Uuid
  partner                   HotelPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accountHolder             String       @map("account_holder")
  bankName                  String       @map("bank_name")
  accountNumber             String       @map("account_number")
  bankBranch                String?      @map("bank_branch")
  swiftCode                 String?      @map("swift_code")
  taxIdVatNumber            String?      @map("tax_id_vat_number")
  registeredBusinessAddress String?      @map("registered_business_address")
  isPrimary                 Boolean      @default(true) @map("is_primary")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @default(now()) @updatedAt @map("updated_at")

  payouts Payout[]

  @@map("hotel_payout_accounts")
}

// Khai báo cấu hình phòng lúc đăng ký (1-1 với Hotel; KHÔNG phải phòng vận hành thật)
model HotelRoomConfig {
  id         String   @id @default(uuid()) @db.Uuid
  hotelId    String   @unique @map("hotel_id") @db.Uuid
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  totalRooms Int      @map("total_rooms") // Số phòng dự kiến khai báo lúc đăng ký
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  types HotelRoomConfigType[]

  @@map("hotel_room_configs")
}

// Mỗi loại phòng khai báo: tên + số lượng (chưa có giá/phòng cụ thể; setup thật ở portal sau)
model HotelRoomConfigType {
  id           String          @id @default(uuid()) @db.Uuid
  roomConfigId String          @map("room_config_id") @db.Uuid
  roomConfig   HotelRoomConfig @relation(fields: [roomConfigId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name         String
  quantity     Int
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_room_config_types")
}

// ===== Chi tiết khách sạn kiểu booking.com (Pha 1) =====

// Thông tin liên hệ của khách sạn (địa điểm, tổng đài, bộ phận đặt phòng, hoá đơn...)
model HotelContact {
  id          String            @id @default(uuid()) @db.Uuid
  hotelId     String            @map("hotel_id") @db.Uuid
  hotel       Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactType HotelContactType  @map("contact_type")
  name        String?
  jobTitle    String?           @map("job_title")
  email       String?
  phone       String?
  phoneType   ContactPhoneType? @map("phone_type")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_contacts")
}

// Chính sách / phụ phí của khách sạn (huỷ, thuế, phí, đỗ xe, internet, đặt cọc)
// Điều khoản khách sạn muốn khách ĐỌC (nhận/trả phòng, thú cưng, trẻ em, đỗ xe...). Thuần văn bản,
// KHÔNG ảnh hưởng tới tiền — khoản thu thật nằm ở HotelCharge, chính sách huỷ thật nằm ở
// hotel.settings.cancellation. Tách vậy để sửa câu chữ không bao giờ làm lệch số tiền.
model HotelPolicy {
  id          String   @id @default(uuid()) @db.Uuid
  hotelId     String   @map("hotel_id") @db.Uuid
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title       String
  description String?
  // Điều khoản quan trọng — khách dễ bỏ sót mà lại hay gây tranh cãi, FE nên làm nổi bật
  important   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_policies")
}

// Thuế/phí CỘNG VÀO tiền đơn. Engine tính giá đọc bảng này (xem availability.computeTaxAndFees):
//  - isPercentage = true  ⇒ amount là % tính trên tiền phòng, chargeFrequency bị BỎ QUA
//  - isPercentage = false ⇒ amount là số tiền tuyệt đối, nhân theo chargeFrequency
// Số tính ra được ĐÓNG BĂNG vào Booking.taxAmount/feeAmount lúc đặt.
model HotelCharge {
  id              String           @id @default(uuid()) @db.Uuid
  hotelId         String           @map("hotel_id") @db.Uuid
  hotel           Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chargeType      ChargeType       @map("charge_type")
  // Tên hiển thị trên bảng phân tích giá, vd "VAT 8%", "Phí dịch vụ"
  name            String
  amount          Decimal          @db.Decimal(12, 2)
  isPercentage    Boolean          @default(false) @map("is_percentage")
  chargeFrequency ChargeFrequency? @map("charge_frequency")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_charges")
}

// Địa điểm lân cận khách sạn (bãi biển, sân bay, điểm tham quan...) + khoảng cách
model HotelNearbyPlace {
  id             String               @id @default(uuid()) @db.Uuid
  hotelId        String               @map("hotel_id") @db.Uuid
  hotel          Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name           String
  category       NearbyPlaceCategory
  distance       Decimal              @db.Decimal(8, 2)
  distanceUnit   DistanceUnit         @map("distance_unit")
  transportType  NearbyTransportType? @map("transport_type")
  journeyMinutes Int?                 @map("journey_minutes") @db.SmallInt
  createdAt      DateTime             @default(now()) @map("created_at")

  @@map("hotel_nearby_places")
}

// Cấu hình giường của một loại phòng (mỗi dòng = 1 kiểu giường + số lượng)
model RoomBed {
  id         String   @id @default(uuid()) @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bedType    BedType  @map("bed_type")
  quantity   Int      @default(1) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("room_beds")
}

// Đợt chi trả tiền cho khách sạn (gom nhiều hoa hồng/booking vào 1 kỳ thanh toán)
model Payout {
  id                  String             @id @default(uuid()) @db.Uuid
  hotelId             String             @map("hotel_id") @db.Uuid
  hotel               Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partnerId           String             @map("partner_id") @db.Uuid
  partner             HotelPartner       @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payoutAccountId     String             @map("payout_account_id") @db.Uuid
  payoutAccount       HotelPayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount              Decimal            @db.Decimal(12, 2) // tổng net trả cho KS trong kỳ
  currency            String             @default("VND") @db.VarChar(3)
  periodStart         DateTime?          @map("period_start") @db.Date
  periodEnd           DateTime?          @map("period_end") @db.Date
  status              PayoutStatus
  payoutTransactionId String?            @map("payout_transaction_id") // đối soát với sao kê ngân hàng
  processedAt         DateTime?          @map("processed_at")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")

  commissions PlatformCommission[]

  @@map("payouts")
}
