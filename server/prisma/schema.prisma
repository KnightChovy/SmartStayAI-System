// ==========================================
// 3. ĐĂNG KÝ HOTEL PARTNER (Hồ sơ & duyệt)
// ==========================================

// Một yêu cầu duyệt hồ sơ đăng ký khách sạn của partner
model HotelVerificationRequest {
  id              String                    @id @default(uuid()) @db.Uuid
  partnerId       String                    @map("partner_id") @db.Uuid
  partner         HotelPartner              @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId         String                    @map("hotel_id") @db.Uuid
  hotel           Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status          VerificationRequestStatus
  submittedAt     DateTime                  @default(now()) @map("submitted_at")
  reviewedBy      String?                   @map("reviewed_by") @db.Uuid
  reviewer        User?                     @relation("verificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedAt      DateTime?                 @map("reviewed_at")
  rejectionReason String?                   @map("rejection_reason")
  notes           String?
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @default(now()) @updatedAt @map("updated_at")

  documents       HotelVerificationDocument[]
  licenses        HotelLicense[]

  @@map("hotel_verification_requests")
}

// File giấy tờ nộp kèm để duyệt (mỗi file có trạng thái duyệt riêng)
model HotelVerificationDocument {
  id                    String                     @id @default(uuid()) @db.Uuid
  verificationRequestId String                     @map("verification_request_id") @db.Uuid
  verificationRequest   HotelVerificationRequest   @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  partnerId             String                     @map("partner_id") @db.Uuid
  partner               HotelPartner               @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hotelId               String                     @map("hotel_id") @db.Uuid
  hotel                 Hotel                      @relation(fields: [hotelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentType          VerificationDocumentType   @map("document_type")
  fileUrl               String                     @map("file_url")
  status                VerificationDocumentStatus
  reviewedBy            String?                    @map("reviewed_by") @db.Uuid
  reviewer              User?                      @relation("documentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedAt            DateTime?                  @map("reviewed_at")
  // Tự tham chiếu: document này được thay thế bởi document nào (khi nộp lại)
  replacedById          String?                    @map("replaced_by") @db.Uuid
  replacedBy            HotelVerificationDocument?  @relation("documentReplacement", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces              HotelVerificationDocument[] @relation("documentReplacement")
  // Các license đang trỏ tới document này làm bản file hợp lệ hiện hành
  currentForLicenses    HotelLicense[]              @relation("currentDocument")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @default(now()) @updatedAt @map("updated_at")

  @@map("hotel_verification_documents")
}

// Giấy phép có cấu trúc (số GP, ngày cấp/hết hạn, cơ quan cấp, hạng sao)
model HotelLicense {
  id                    String                    @id @default(uuid()) @db.Uuid
  hotelId               String                    @map("hotel_id") @db.Uuid
  hotel                 Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verificationRequestId String?                   @map("verification_request_id") @db.Uuid
  verificationRequest   HotelVerificationRequest? @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  licenseType           LicenseType               @map("license_type")
  licenseNumber         String?                   @map("license_number")
  certificateNumber     String?                   @map("certificate_number")
  issueDate             DateTime?                 @map("issue_date") @db.Date
  expiryDate            DateTime?                 @map("expiry_date") @db.Date
  authority             String?
  validityStatus        LicenseValidityStatus?    @map("validity_status")
  starRating            LicenseStarRating?        @map("star_rating")
  // File không lưu ở đây nữa: trỏ tới bản document đã duyệt mới nhất trong hotel_verification_documents
  currentDocumentId     String?                    @map("current_document_id") @db.Uuid
  currentDocument       HotelVerificationDocument? @relation("currentDocument", fields: [currentDocumentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @default(now()) @updatedAt @map("updated_at")

  @@index([hotelId, licenseType])
  @@map("hotel_licenses")
}

// Người đại diện pháp lý của khách sạn
model HotelRepresentative {
  id              String             @id @default(uuid()) @db.Uuid
  hotelId         String             @map("hotel_id") @db.Uuid
  hotel           Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
