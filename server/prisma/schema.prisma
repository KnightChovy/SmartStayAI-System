  hotelId             String          @map("hotel_id") @db.Uuid
  hotel               Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  overallRating       Int             @map("overall_rating") @db.SmallInt
  cleanlinessRating   Int             @map("cleanliness_rating") @db.SmallInt
  serviceRating       Int             @map("service_rating") @db.SmallInt
  locationRating      Int             @map("location_rating") @db.SmallInt
  valueRating         Int             @map("value_rating") @db.SmallInt
  title               String?
  content             String
  sentimentLabel      SentimentLabel? @map("sentiment_label")
