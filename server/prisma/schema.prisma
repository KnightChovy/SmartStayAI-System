// Ví per-hotel: mỗi khách sạn có 1 ví. Payout thực tế đi về bank cấp partner,
// cộng dồn số dư available từ ví các hotel thuộc partner đó.
// Ví — thuộc về ĐÚNG MỘT trong hai: khách sạn HOẶC khách hàng.
//
// Ví KHÁCH SẠN: sổ ghi nền tảng đang nợ khách sạn bao nhiêu. balancePending = tiền đang ký quỹ
// (khách đã trả nhưng chưa trả phòng), balanceAvailable = đã tất toán, rút được.
//
// Ví KHÁCH HÀNG: số dư khách dùng trả cho lần đặt sau. Tiền hoàn vào đây KHÔNG rời nền tảng nên
// không cần chuyển khoản tay. Khách chỉ có balanceAvailable — không có khái niệm ký quỹ.
//
// Cả hai cột chủ sở hữu đều nullable vì Prisma không khai được "đúng một trong hai"; ràng buộc
// CHECK num_nonnulls(hotel_id, customer_id) = 1 nằm trong migration để DB tự chặn trạng thái sai.
model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  hotelId          String?  @unique @map("hotel_id") @db.Uuid
  hotel            Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerId       String?  @unique @map("customer_id") @db.Uuid
  customer         User?    @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  balanceAvailable Decimal  @default(0) @map("balance_available") @db.Decimal(14, 2)
  // Chỉ ví khách sạn dùng cột này; ví khách luôn để 0
  balancePending   Decimal  @default(0) @map("balance_pending") @db.Decimal(14, 2)
  currency         String   @default("VND")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String                @id @default(uuid()) @db.Uuid
  walletId     String                @map("wallet_id") @db.Uuid
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 2) // có dấu: + earning, − payout/refund
  balanceAfter Decimal               @map("balance_after") @db.Decimal(14, 2)
  bookingId    String?               @map("booking_id") @db.Uuid
  commissionId String?               @map("commission_id") @db.Uuid
  status       String                @default("completed")
  description  String?
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([walletId])
  @@index([bookingId])
  @@map("wallet_transactions")
}

model Review {
  id                  String          @id @default(uuid()) @db.Uuid
  bookingId           String          @unique @map("booking_id") @db.Uuid
  booking             Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customerId          String          @map("customer_id") @db.Uuid
