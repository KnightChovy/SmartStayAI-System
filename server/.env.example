# Môi trường chạy (BẮT BUỘC): development | production | test
NODE_ENV=development

# PORT
PORT=5000

# URL PostgreSQL (Prisma) — BẮT BUỘC
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartstay_db?schema=public

# URL MongoDB — KHÔNG bắt buộc (chỉ giữ lại cho việc nhận diện kiểu lỗi cũ, có thể bỏ trống)
MONGODB_URL=mongodb://127.0.0.1:27017/smartstay-ai

# JWT Authentication — JWT_SECRET BẮT BUỘC
JWT_SECRET=smartstay_super_secret_key_change_me_in_prod
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Số vòng băm bcrypt cho mật khẩu (mặc định 12 nếu không khai báo)
BCRYPT_ROUNDS=12

# Hệ thống Email (Gửi mã xác nhận, hóa đơn đặt phòng)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=support@smartstay.ai

# URL frontend (dùng để dựng link trong email reset/verify)
CLIENT_URL=http://localhost:5173

# --- CẤU HÌNH ĐẶT PHÒNG KHÁCH SẠN ---

# Cloudinary / AWS S3 (Lưu trữ ảnh phòng, avatar người dùng) — BẮT BUỘC để chạy upload file
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Tỉ lệ hoa hồng (%) mặc định gán cho đối tác mới khi đăng ký khách sạn (mặc định 15)
PARTNER_DEFAULT_COMMISSION_RATE=15

# Key mã hoá số tài khoản nhận tiền của đối tác (AES-256-GCM) — BẮT BUỘC.
# Tạo key 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYOUT_ENCRYPTION_KEY=replace_with_base64_32byte_key

# Thanh toán VNPay (đăng ký sandbox tại https://sandbox.vnpayment.vn/devtool/)
# Để trống TMN_CODE/HASH_SECRET thì API tạo URL thanh toán sẽ báo lỗi cấu hình rõ ràng.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# URL backend mà VNPay redirect trình duyệt về sau khi thanh toán (phải khớp cổng server)
VNP_RETURN_URL=http://localhost:5000/v1/payments/vnpay/return

# Dịch vụ Cache trạng thái phòng trống (Khuyên dùng Redis để chống Overbooking)
REDIS_URL=redis://127.0.0.1:6379

