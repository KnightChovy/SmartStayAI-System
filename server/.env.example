# PORT
PORT=5000

# URL MongoDB (Tùy chỉnh the url database của bạn, ví dụ Atlas hoặc Local)
MONGODB_URL=mongodb://127.0.0.1:27017/smartstay-ai

# JWT Authentication
JWT_SECRET=smartstay_super_secret_key_change_me_in_prod
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Hệ thống Email (Gửi mã xác nhận, hóa đơn đặt phòng)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=support@smartstay.ai

# --- CẤU HÌNH ĐẶT PHÒNG KHÁCH SẠN ---

# Cloudinary / AWS S3 (Lưu trữ ảnh phòng, avatar người dùng)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Thanh toán (Payment Gateways)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Dịch vụ Cache trạng thái phòng trống (Khuyên dùng Redis để chống Overbooking)
REDIS_URL=redis://127.0.0.1:6379

