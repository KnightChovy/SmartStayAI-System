# Sao chép file này thành `.env` rồi điền giá trị thật:  cp .env.example .env
#
# QUAN TRỌNG: Vite thay `import.meta.env.VITE_*` bằng giá trị LÚC BUILD, không
# phải lúc chạy. Nên trên Vercel phải khai đủ các biến dưới đây ở
# Project → Settings → Environment Variables, và **redeploy** sau khi thêm —
# thêm biến mà không build lại thì bundle cũ vẫn giữ nguyên giá trị cũ.

# ── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/v1

# ── VietMap ──────────────────────────────────────────────────────────────────
# Thiếu VITE_MAP_TILE_URL thì map ở form verify khách sạn hiện khung xám
# "Map chưa cấu hình", còn map ở trang chi tiết KS lùi về tile OpenStreetMap.
# Key nằm ngay trong URL và luôn bị bundle ra client — đây không phải secret,
# nhưng vẫn đừng commit giá trị thật vào git (để còn xoay key được).
VITE_MAP_TILE_URL=https://maps.vietmap.vn/maps/tiles/st/{z}/{x}/{y}.png?apikey=<vietmap_map_key>
VITE_MAP_ATTRIBUTION=© VietMap

# Key RIÊNG cho autocomplete/geocoding (`/api/autocomplete/v4`, `/api/place/v3`).
# KHÔNG dùng chung với key tile ở trên — VietMap trả 423 nếu dùng nhầm key.
# Thiếu key này thì ô "Address Search" ở bước Business Info im lặng không ra
# gợi ý nào (service nuốt lỗi, không báo gì).
VITE_API_SEARCH_KEY=<vietmap_search_key>
